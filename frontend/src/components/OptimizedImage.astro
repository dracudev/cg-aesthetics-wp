---
/**
 * Optimized Image Component with lazy loading and responsive sizes
 */
import { getFallbackImage } from '../data/cache-utils';

export interface OptimizedImageProps {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
  quality?: number;
  fallbackType?: 'hero' | 'service' | 'testimonial';
}

const {
  src,
  alt,
  width,
  height,
  sizes = '100vw',
  class: className = '',
  loading = 'lazy',
  decoding = 'async',
  fetchpriority = 'auto',
  quality = 85,
  fallbackType = 'hero',
} = Astro.props as OptimizedImageProps;

// Ensure we have a valid image source
let finalSrc = src || getFallbackImage(fallbackType);

// Replace localhost URLs with production URLs
const PRODUCTION_URL = import.meta.env.PUBLIC_WORDPRESS_URL || 'https://carmeng-beauty.com';
if (finalSrc.includes('localhost:8000')) {
  finalSrc = finalSrc.replace('http://localhost:8000', PRODUCTION_URL);
}

// Validate URL
try {
  new URL(finalSrc);
} catch {
  console.warn(`Invalid image URL: ${finalSrc}, using fallback`);
  finalSrc = getFallbackImage(fallbackType);
}

// For WordPress images, don't modify URLs - use as-is
// WordPress already provides optimized images through its media library
const isWordPressImage = finalSrc.includes('/wp-content/uploads/');

// Use original WordPress URL without modifications
const optimizedSrc = finalSrc;

// Don't generate srcset for WordPress images - they have their own responsive variants
const srcset = isWordPressImage ? '' : '';
---

<img
  src={optimizedSrc}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding={decoding}
  fetchpriority={fetchpriority}
  class={className}
/>
